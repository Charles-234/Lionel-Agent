# ============================================================
# Phantom Agent - Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your own values.
# NEVER commit .env to Git. .env is gitignored.
# All values below are intentionally empty - configure them
# in your environment or in a local .env file.
# ============================================================

# --- Required (Telemetry / Routing) ---
ADMIN_TELEGRAM_ID=
OMNIROUTE_URL=
OMNIROUTE_API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ONLINE_MODE=

